# Rust / build
/target/
**/*.rs.bk

# JS / frontend if introduced later
node_modules/
dist/
.next/
.output/

# Local env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Local artifacts
# /.tools/ holds the checksum-pinned binaries the CI gates download
# (db-inspect, the Dioxus CLI). They must never be committed: a vendored
# binary would also fail the REUSE gate.
/.tools/
/out/
/tmp/
*.log
.DS_Store

# Generated reports
/reports/
/playwright-report/
/test-results/
